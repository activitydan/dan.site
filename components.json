    "@crafterui": "https://crafterui.com/r/{name}.json",
    "@bjork-ui": "https://ui.isaiahbjork.com/{name}.json",
    "@morphiq": "https://morphiq.prathampatel.design/r/{name}.json",
    "@liquefy-ui": "https://liquefy-ui.com/r/{name}.json",
    "@mewo": "https://mewo-ui.vercel.app/r/{name}.json",
    "@awwwardedui": "https://awwwardedui.vercel.app/r/{name}.json",
    "@ui-layouts": "https://ui-layouts.com/r/{name}.json",
